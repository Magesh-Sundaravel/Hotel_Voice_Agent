# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
# Postgres URI for LangGraph PostgresSaver checkpointer:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Hotel Defaults (Sina Bernini Bristol, Roma)
DEFAULT_HOTEL_NAME="Sina Bernini Bristol"
DEFAULT_HOTEL_PHONE="+39 06 4883051"
DEFAULT_HOTEL_ADDRESS="Piazza Barberini 23, Roma"
DEFAULT_TIMEZONE="Europe/Rome"

# Server
PORT=8000
ENVIRONMENT=development
# Public URL (e.g. from ngrok) for Twilio Webhooks: e.g. https://your-domain.ngrok-free.app
PUBLIC_URL=
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Twilio Telephony & SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+39064883051

# ElevenLabs Voice (TTS & STT)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# STT Provider ("groq" or "elevenlabs")
STT_PROVIDER=groq

# Email / SMTP Confirmation Settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=prenotazioni@sinahotels.com

# Owner Notifications
OWNER_EMAIL=owner@sinabernini.it
OWNER_PHONE=+39335XXXXXXX

# API Authentication & Security
API_KEY=your_secret_api_key_here
TWILIO_VALIDATE_SIGNATURE=false

# Voice Activity Detection (VAD)
VAD_PROVIDER=webrtc
VAD_MODE=2
